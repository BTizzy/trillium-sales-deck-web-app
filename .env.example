# Scraper-Hubspot — Environment Variables Template
#
# Copy this file to .env in the root of the Scraper-Hubspot repository and
# fill in your values. The .env file is gitignored and must never be committed.
#
# Usage:
#   cp .env.example ../.env   (from the scripts/ directory)
#   # or
#   cp .env.example .env      (from the repo root)

# ── HubSpot Private App Access Token ──────────────────────────────────────────
# Required for push_to_hubspot.py and the --hubspot-push flag in daily_run.py.
#
# How to get this token:
#   1. Log in to HubSpot as an account admin.
#   2. Go to Settings → Integrations → Private Apps → Create a private app.
#   3. Add scopes: crm.objects.contacts.read + crm.objects.contacts.write
#   4. Create the app and copy the access token shown.
#
# Token format: pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_API_KEY=

# ── Hunter.io API Key (optional) ──────────────────────────────────────────────
# Used by waterfall_enricher.py for contact discovery.
# Free tier: 25 searches/month. Get a key at https://hunter.io
HUNTER_API_KEY=

# ── Skrapp.io API Key (optional) ──────────────────────────────────────────────
# Secondary contact enrichment source.
# Free tier: 100 credits/month. Get a key at https://skrapp.io
SKRAPP_API_KEY=
